# Copy to .env.local. Every value is optional.

# Identifies your app to the free OpenStreetMap services (they ask for this). Use your own email.
APP_CONTACT_EMAIL=you@example.com

# Defaults are the public community servers. For real traffic, host your own or use a paid provider.
# PHOTON_URL=https://photon.komoot.io
# OSRM_URL=https://router.project-osrm.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
